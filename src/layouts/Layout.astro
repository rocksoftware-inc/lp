---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	lang?: string;
	image?: string;
	canonical?: string;
	noindex?: boolean;
}

const {
	lang = "pt-br",
	noindex = false,
	title = lang === "pt-br"
		? "RockSoftware | Software House & Desenvolvimento de Software de Alta Performance"
		: "RockSoftware | Next-Gen Software House & High-Performance Engineering",
	description = lang === "pt-br"
		? "A RockSoftware é uma software house especializada em desenvolvimento de software de alta performance, aplicativos web e mobile, arquitetura cloud e soluções inteligentes com IA."
		: "RockSoftware is an elite software engineering company delivering high-performance web and mobile apps, scalable cloud architectures, and intelligent AI solutions.",
	keywords = lang === "pt-br"
		? "software house, desenvolvimento de software, desenvolvimento de aplicativos, desenvolvimento web, consultoria de software, inteligência artificial, react, nodejs, rust, computação em nuvem, são paulo, alphaville, rocksoftware, rock software, rocks software, rocking software, softwares, rocker software"
		: "software development, software house, custom software engineering, full stack development, cloud architecture, high performance web, ai integration, react, nodejs, rust, rocksoftware, rock software, rocks software, rocking software, softwares, rocker software",
	image = "/og-image.jpg",
	canonical,
} = Astro.props;

const siteUrl = "https://rocksoftware.co";
const currentPath = Astro.url.pathname;
const canonicalURL = canonical || new URL(currentPath, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;

const isPt = lang === "pt-br";
const ogLocale = isPt ? "pt_BR" : "en_US";
const ogAlternateLocale = isPt ? "en_US" : "pt_BR";

const schemaData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${siteUrl}/#organization`,
			"name": "RockSoftware",
			"alternateName": "RockSoftware Tecnologia da Informação Ltda",
			"legalName": "ROCKSOFTWARE TECNOLOGIA DA INFORMACAO LTDA",
			"taxID": "52.188.782/0001-38",
			"url": siteUrl,
			"logo": `${siteUrl}/rock-logo.png`,
			"image": `${siteUrl}/logo.jpg`,
			"email": "bizzness@rocksoftware.co",
			"telephone": "+5511947376930",
			"sameAs": [
				"https://www.linkedin.com/company/rocksoftware-inc/",
				"https://github.com/rocksoftware-inc",
				"https://www.instagram.com/rock.software"
			],
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "São Paulo",
				"addressRegion": "SP",
				"addressCountry": "BR"
			}
		},
		{
			"@type": "ProfessionalService",
			"@id": `${siteUrl}/#service`,
			"name": "RockSoftware - Software House",
			"url": siteUrl,
			"image": `${siteUrl}/logo.jpg`,
			"priceRange": "$$",
			"telephone": "+5511947376930",
			"email": "bizzness@rocksoftware.co",
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": "5.0",
				"bestRating": "5",
				"worstRating": "1",
				"ratingCount": "19",
				"reviewCount": "19"
			},
			"description": isPt
				? "Desenvolvimento de software de alta performance, aplicativos mobile, engenharia web, inteligência artificial e consultoria em arquitetura cloud."
				: "High-performance software engineering, mobile applications, web systems, artificial intelligence, and cloud architecture consulting.",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "São Paulo",
				"addressRegion": "SP",
				"addressCountry": "BR"
			},
			"areaServed": [
				{ "@type": "Country", "name": "Brazil" },
				{ "@type": "Country", "name": "Worldwide" }
			]
		},
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			"url": siteUrl,
			"name": "RockSoftware",
			"publisher": {
				"@id": `${siteUrl}/#organization`
			},
			"inLanguage": ["pt-BR", "en-US"]
		},
		{
			"@type": "BreadcrumbList",
			"@id": `${siteUrl}/#breadcrumb`,
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": isPt ? "Serviços" : "Services",
					"item": `${siteUrl}/#services`
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Cases",
					"item": `${siteUrl}/#cases`
				},
				{
					"@type": "ListItem",
					"position": 4,
					"name": isPt ? "Sobre" : "About",
					"item": `${siteUrl}/#about`
				},
				{
					"@type": "ListItem",
					"position": 5,
					"name": isPt ? "Orçamento" : "Quote",
					"item": `${siteUrl}/#quote`
				},
				{
					"@type": "ListItem",
					"position": 6,
					"name": "FAQ",
					"item": `${siteUrl}/#faq`
				},
				{
					"@type": "ListItem",
					"position": 7,
					"name": isPt ? "Contato" : "Contact",
					"item": `${siteUrl}/#contact`
				}
			]
		},
		{
			"@type": "FAQPage",
			"@id": `${siteUrl}/#faq`,
			"mainEntity": isPt ? [
				{
					"@type": "Question",
					"name": "Quanto tempo leva para desenvolver um MVP ou software com a RockSoftware?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Entregamos MVPs ágeis e funcionais entre 2 a 6 semanas, utilizando metodologias ágeis, arquitetura modular e ciclos rápidos de validação com o cliente."
					}
				},
				{
					"@type": "Question",
					"name": "Quais tecnologias a RockSoftware utiliza nos projetos?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Trabalhamos com tecnologias modernas de alta performance, incluindo React, Next.js, Astro, TypeScript, Node.js, Go, Rust, Python para IA, PostgreSQL, Redis e soluções cloud em AWS e Cloudflare."
					}
				},
				{
					"@type": "Question",
					"name": "Como funciona o suporte e manutenção após a entrega?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Oferecemos garantia técnica, planos de evolução contínua, monitoramento 24/7 com alta disponibilidade (99.99%) e SLAs de atendimento prioritário."
					}
				},
				{
					"@type": "Question",
					"name": "A RockSoftware atende empresas de qualquer região?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Nossa sede está em Alphaville (São Paulo), mas atendemos clientes em todo o Brasil e no exterior (EUA, Europa e América Latina) com squads dedicados e comunicação ágil."
					}
				},
				{
					"@type": "Question",
					"name": "Como solicitar uma estimativa ou proposta de desenvolvimento?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Você pode simular seu projeto diretamente em nosso simulador de orçamento em https://rocksoftware.co/#quote, enviar um e-mail para bizzness@rocksoftware.co ou chamar via WhatsApp (+55 11 94737-6930) com resposta em até 2 horas úteis."
					}
				}
			] : [
				{
					"@type": "Question",
					"name": "How long does it take to develop an MVP with RockSoftware?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "We deliver production-ready, agile MVPs in 2 to 6 weeks using modern modular architecture and fast iterative development cycles."
					}
				},
				{
					"@type": "Question",
					"name": "What tech stack does RockSoftware specialize in?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "We specialize in high-performance stacks including React, Next.js, Astro, TypeScript, Node.js, Go, Rust, Python AI engineering, PostgreSQL, Redis, and cloud infrastructure on AWS and Cloudflare."
					}
				},
				{
					"@type": "Question",
					"name": "Do you offer post-launch support and maintenance?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes, we provide technical warranties, continuous feature scaling, 24/7 infrastructure monitoring (99.99% uptime), and dedicated SLA support."
					}
				},
				{
					"@type": "Question",
					"name": "Does RockSoftware work with international clients?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes! Headquartered in Alphaville / São Paulo, we partner with clients worldwide across North America, Europe, and Latin America with dedicated remote squads."
					}
				}
			]
		}
	]
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="RockSoftware" />
		<meta name="theme-color" content="#f43f5e" />
		<meta name="color-scheme" content="dark" />

		<!-- Search Engine Crawlers & Indexing -->
		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<>
				<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
				<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
				<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
			</>
		)}

		<!-- Canonical & Multilingual Alternate Hreflang Tags -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="pt-br" href="https://rocksoftware.co/" />
		<link rel="alternate" hreflang="pt-BR" href="https://rocksoftware.co/" />
		<link rel="alternate" hreflang="en" href="https://rocksoftware.co/en/" />
		<link rel="alternate" hreflang="x-default" href="https://rocksoftware.co/" />

		<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="RockSoftware" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:secure_url" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:alt" content="RockSoftware - Intelligent Solutions. Robust Build." />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogAlternateLocale} />

		<!-- Twitter / X Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@rocksoftware" />
		<meta name="twitter:creator" content="@rocksoftware" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content="RockSoftware - Intelligent Solutions. Robust Build." />

		<!-- Favicons & Touch Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<!-- Web App Manifest -->
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Geotagging & Local SEO (Alphaville / São Paulo) -->
		<meta name="geo.region" content="BR-SP" />
		<meta name="geo.placename" content="Barueri, Alphaville, São Paulo" />
		<meta name="geo.position" content="-23.4984;-46.8529" />
		<meta name="ICBM" content="-23.4984, -46.8529" />

		<!-- Preload Critical LCP Asset -->
		<link rel="preload" as="image" href="/bg-1.jpg" type="image/jpeg" fetchpriority="high" />

		<!-- Preconnect and Performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="dns-prefetch" href="https://fonts.googleapis.com">
		<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lobster&family=Raleway:wght@300;400;600;700;800&display=swap" rel="stylesheet">

		<!-- LLM / AI Search Engine Knowledge Link (https://llmstxt.org/) -->
		<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM Knowledge File" />

		<!-- JSON-LD Structured Data for Google Knowledge Graph & Rich Results -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
	</head>
	<body>
		<slot />

		<!-- Custom Cursor for Pointer Mode -->
		<div id="custom-cursor"></div>
		<script>
			const cursor = document.getElementById('custom-cursor');
			
			// Show custom cursor only when hovering over clickable elements
			document.addEventListener('mousemove', (e) => {
				if (cursor) {
					cursor.style.left = e.clientX + 'px';
					cursor.style.top = e.clientY + 'px';
				}
			});

			const addCursorEvents = () => {
				const interactables = document.querySelectorAll('a, button, .btn, .cta-btn, [role="button"]');
				interactables.forEach(el => {
					el.addEventListener('mouseenter', () => {
						if (cursor) cursor.classList.add('active');
					});
					el.addEventListener('mouseleave', () => {
						if (cursor) cursor.classList.remove('active');
					});
				});
			};

			// Run on mount
			addCursorEvents();
		</script>
	</body>
</html>
