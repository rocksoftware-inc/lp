---
import Layout from '../layouts/Layout.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="RockSoftware | Intelligent Solutions. Robust Build." lang={lang}>
    <!-- Hero Background (first 100vh / 100vw, 1920x1080) -->
    <div id="hero-bg" class="hero-bg">
        <div class="hero-bg-slide active" style="background-image: url('/bg-1.jpg');"></div>
        <div class="hero-bg-slide" style="background-image: url('/bg-2.jpg');"></div>
        <div class="hero-bg-slide" style="background-image: url('/bg-3.jpg');"></div>
        <div class="hero-bg-slide" style="background-image: url('/bg-4.jpg');"></div>
        <div class="hero-bg-overlay"></div>
    </div>

    <!-- Floating ambient orbs -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>

	<main class="container">
		<nav class="navbar animate-slide-down" id="navbar">
			<div class="logo" style="display: flex; align-items: center; justify-content: center; border-radius: 10px; background-color: rgb(245, 245, 245, .85); rotate: 45deg;">
				<img src="/rock-logo.png" style="rotate: -45deg;" alt="RockSoftware Logo" />
			</div>
			<div class="nav-links">
				<a href="#services">{t('nav.services')}</a>
				<a href="#cases">{t('nav.cases')}</a>
				<a href="#about">{t('nav.about')}</a>
				<a href="#quote">{t('nav.quote')}</a>
				<a href="#contact" class="btn lowercase font-cascadia-bold">{t('nav.contact')}</a>
                <div class="lang-selector">
                    <a href="/" class={`lang-link ${lang === 'pt-br' ? 'active' : ''}`}>PT</a>
                    <a href="/en/" class={`lang-link ${lang === 'en' ? 'active' : ''}`}>EN</a>
                </div>
			</div>
		</nav>

		<header class="hero" id="hero">
			<div class="hero-content animate-slide-up" style="animation-delay: 0.2s">
				<div class="badge"><span class="font-cascadia lowercase">{t('hero.badge')}</span></div>
				<h1>{t('hero.title1')} <span class="highlight font-cascadia lowercase">{t('hero.title2')}</span></h1>
				<p>{t('hero.subtitle')}</p>
				<div class="hero-actions">
					<button class="cta-btn font-cascadia-bold lowercase" id="explore-btn">
						{t('hero.explore')}
						<svg class="cta-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</button>
				</div>
			</div>
			<div class="hero-visual animate-fade-in" style="animation-delay: 0.4s">
                <div class="code-window">
                    <div class="code-header">
                        <div class="code-dots">
                            <span class="dot-red"></span>
                            <span class="dot-yellow"></span>
                            <span class="dot-green"></span>
                        </div>
                        <span class="code-title font-cascadia lowercase" style="font-size: 0.75rem; color: #71717a;">rocksoftware.ts</span>
                    </div>
                    <pre class="code-body font-cascadia lowercase"><span class="code-keyword">const</span> <span class="code-var">rock</span> = {
  <span class="code-prop">mission</span>: <span class="code-string">"build the future"</span>,
  <span class="code-prop">stack</span>: [<span class="code-string">"react"</span>, <span class="code-string">"node"</span>, <span class="code-string">"rust"</span>],
  <span class="code-prop">performance</span>: <span class="code-number">100</span>,
  <span class="code-prop">deploy</span>: () <span class="code-keyword">=></span> <span class="code-string">"🚀"</span>,
};</pre>
                </div>
				<div class="geometry geometry-1"></div>
				<div class="geometry geometry-2"></div>
			</div>
		</header>
        
        <!-- Marquee effect for extra liveliness -->
        <div class="marquee-container">
            <div class="marquee-scroll align-middle">
                <span class="font-cascadia-bold lowercase">{t('marquee.1')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.2')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.3')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.4')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.1')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.2')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.3')}</span><span class="dot"> • </span><span class="font-cascadia-bold lowercase">{t('marquee.4')}</span><span class="dot"> • </span>
            </div>
        </div>

		<!-- Services Section -->
		<section id="services" class="section relative overflow-hidden py-24">
			<!-- Background effects -->
			<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-rose-900/10 via-zinc-950/0 to-zinc-950/0 pointer-events-none"></div>
			<div class="absolute right-0 top-1/4 w-96 h-96 bg-rose-600/10 rounded-full blur-3xl -z-10 animate-pulse" style="animation-duration: 8s;"></div>
			
			<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">{t('services.title1')} <span class="text-rose-500 italic lowercase font-cascadia">{t('services.title2')}</span></h2>
				<p class="max-w-2xl text-xl text-zinc-400 mb-20 leading-relaxed">
					{t('services.subtitle')}
				</p>
				
				<!-- Development Workflow Diagram -->
				<div class="workflow-diagram">
					<!-- Grid pattern background -->
					<div class="workflow-grid"></div>
					<!-- Top glow -->
					<div class="workflow-glow"></div>

					<!-- Title bar -->
					<div class="workflow-header">
						<div class="workflow-dots">
							<span></span><span></span><span></span>
						</div>
						<span class="workflow-header-title font-cascadia lowercase">{t('workflow.title')}</span>
						<div class="workflow-status">
							<span class="status-dot"></span>
							<span class="font-cascadia lowercase" style="font-size: 0.7rem; color: #34d399;">{t('workflow.status')}</span>
						</div>
					</div>

					<!-- Flowchart body -->
					<div class="flowchart">
						<!-- Start Event -->
						<div class="flow-start">
							<div class="start-circle">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,3 20,12 6,21"/></svg>
							</div>
							<span class="flow-label font-cascadia lowercase">{t('workflow.start')}</span>
						</div>

						<!-- Arrow -->
						<div class="flow-connector">
							<div class="connector-line"></div>
							<div class="connector-chevron">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
							</div>
						</div>

						<!-- Step 1: Discovery -->
						<div class="flow-node flow-node-task" data-step="1">
							<div class="node-icon-bar">
								<svg class="node-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
							</div>
							<div class="node-content">
								<h4 class="font-cascadia lowercase">{t('workflow.step1.title').replace('01 ', '')}</h4>
								<p>{t('workflow.step1.desc')}</p>
							</div>
							<div class="node-badge">01</div>
						</div>

						<!-- Arrow -->
						<div class="flow-connector">
							<div class="connector-line"></div>
							<div class="connector-chevron">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
							</div>
						</div>

						<!-- Step 2: Design -->
						<div class="flow-node flow-node-task" data-step="2">
							<div class="node-icon-bar">
								<svg class="node-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
							</div>
							<div class="node-content">
								<h4 class="font-cascadia lowercase">{t('workflow.step2.title').replace('02 ', '')}</h4>
								<p>{t('workflow.step2.desc')}</p>
							</div>
							<div class="node-badge">02</div>
						</div>

						<!-- Arrow -->
						<div class="flow-connector">
							<div class="connector-line"></div>
							<div class="connector-chevron">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
							</div>
						</div>

						<!-- Decision Gateway (Diamond) -->
						<div class="flow-gateway">
							<div class="gateway-diamond">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
							</div>
							<span class="flow-label font-cascadia lowercase">{t('workflow.review')}</span>
						</div>

						<!-- Arrow -->
						<div class="flow-connector">
							<div class="connector-line"></div>
							<div class="connector-chevron">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
							</div>
						</div>

						<!-- Step 3: Build -->
						<div class="flow-node flow-node-task" data-step="3">
							<div class="node-icon-bar">
								<svg class="node-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
							</div>
							<div class="node-content">
								<h4 class="font-cascadia lowercase">{t('workflow.step3.title').replace('03 ', '')}</h4>
								<p>{t('workflow.step3.desc')}</p>
							</div>
							<div class="node-badge">03</div>
						</div>

						<!-- Arrow -->
						<div class="flow-connector">
							<div class="connector-line"></div>
							<div class="connector-chevron">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
							</div>
						</div>

						<!-- Step 4: Deliver -->
						<div class="flow-node flow-node-task" data-step="4">
							<div class="node-icon-bar">
								<svg class="node-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 13l4 4L19 7"/></svg>
							</div>
							<div class="node-content">
								<h4 class="font-cascadia lowercase">{t('workflow.step4.title').replace('04 ', '')}</h4>
								<p>{t('workflow.step4.desc')}</p>
							</div>
							<div class="node-badge">04</div>
						</div>

						<!-- Arrow -->
						<div class="flow-connector">
							<div class="connector-line"></div>
							<div class="connector-chevron">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
							</div>
						</div>

						<!-- End Event -->
						<div class="flow-end">
							<div class="end-circle">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
							</div>
							<span class="flow-label font-cascadia lowercase">{t('workflow.deploy')}</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Cases Section -->
		<section id="cases" class="section cases-section relative py-24">
			<div class="cases-ambient"></div>
			<div class="section-header">
				<div class="badge"><span class="font-cascadia lowercase">{t('cases.badge')}</span></div>
				<h2>{t('cases.title1')} <span class="highlight font-cascadia lowercase">{t('cases.title2')}</span></h2>
				<p class="section-desc">{t('cases.subtitle')}</p>
			</div>

			<!-- Filter tabs -->
			<div class="cases-filters font-cascadia lowercase">
				<button type="button" class="case-filter-btn active" data-filter="all">{t('cases.filter.all')}</button>
				<button type="button" class="case-filter-btn" data-filter="fintech">{t('cases.filter.fintech')}</button>
				<button type="button" class="case-filter-btn" data-filter="cloud">{t('cases.filter.cloud')}</button>
				<button type="button" class="case-filter-btn" data-filter="ecommerce">{t('cases.filter.ecommerce')}</button>
			</div>

			<!-- Cases Grid -->
			<div class="cases-grid">
				<!-- Case 1 -->
				<div class="case-card" data-category="fintech">
					<div class="case-card-glow"></div>
					<div class="case-header">
						<div class="case-meta">
							<span class="case-tag font-cascadia lowercase">{t('cases.item1.badge')}</span>
							<h3 class="case-title">{t('cases.item1.title')}</h3>
						</div>
						<div class="case-arrow">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
						</div>
					</div>
					<p class="case-desc">{t('cases.item1.desc')}</p>
					
					<div class="case-metrics">
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item1.metric1.val')}</span>
							<span class="metric-lbl">{t('cases.item1.metric1.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item1.metric2.val')}</span>
							<span class="metric-lbl">{t('cases.item1.metric2.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item1.metric3.val')}</span>
							<span class="metric-lbl">{t('cases.item1.metric3.label')}</span>
						</div>
					</div>

					<div class="case-tech-stack">
						<span class="tech-chip">Rust</span>
						<span class="tech-chip">Next.js</span>
						<span class="tech-chip">Kafka</span>
						<span class="tech-chip">ClickHouse</span>
					</div>
				</div>

				<!-- Case 2 -->
				<div class="case-card" data-category="cloud">
					<div class="case-card-glow"></div>
					<div class="case-header">
						<div class="case-meta">
							<span class="case-tag font-cascadia lowercase">{t('cases.item2.badge')}</span>
							<h3 class="case-title">{t('cases.item2.title')}</h3>
						</div>
						<div class="case-arrow">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
						</div>
					</div>
					<p class="case-desc">{t('cases.item2.desc')}</p>
					
					<div class="case-metrics">
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item2.metric1.val')}</span>
							<span class="metric-lbl">{t('cases.item2.metric1.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item2.metric2.val')}</span>
							<span class="metric-lbl">{t('cases.item2.metric2.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item2.metric3.val')}</span>
							<span class="metric-lbl">{t('cases.item2.metric3.label')}</span>
						</div>
					</div>

					<div class="case-tech-stack">
						<span class="tech-chip">Go</span>
						<span class="tech-chip">Python</span>
						<span class="tech-chip">Temporal</span>
						<span class="tech-chip">FastAPI</span>
					</div>
				</div>

				<!-- Case 3 -->
				<div class="case-card" data-category="ecommerce">
					<div class="case-card-glow"></div>
					<div class="case-header">
						<div class="case-meta">
							<span class="case-tag font-cascadia lowercase">{t('cases.item3.badge')}</span>
							<h3 class="case-title">{t('cases.item3.title')}</h3>
						</div>
						<div class="case-arrow">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
						</div>
					</div>
					<p class="case-desc">{t('cases.item3.desc')}</p>
					
					<div class="case-metrics">
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item3.metric1.val')}</span>
							<span class="metric-lbl">{t('cases.item3.metric1.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item3.metric2.val')}</span>
							<span class="metric-lbl">{t('cases.item3.metric2.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item3.metric3.val')}</span>
							<span class="metric-lbl">{t('cases.item3.metric3.label')}</span>
						</div>
					</div>

					<div class="case-tech-stack">
						<span class="tech-chip">Astro</span>
						<span class="tech-chip">TypeScript</span>
						<span class="tech-chip">Tailwind</span>
						<span class="tech-chip">Stripe</span>
					</div>
				</div>

				<!-- Case 4 -->
				<div class="case-card" data-category="cloud">
					<div class="case-card-glow"></div>
					<div class="case-header">
						<div class="case-meta">
							<span class="case-tag font-cascadia lowercase">{t('cases.item4.badge')}</span>
							<h3 class="case-title">{t('cases.item4.title')}</h3>
						</div>
						<div class="case-arrow">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
						</div>
					</div>
					<p class="case-desc">{t('cases.item4.desc')}</p>
					
					<div class="case-metrics">
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item4.metric1.val')}</span>
							<span class="metric-lbl">{t('cases.item4.metric1.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item4.metric2.val')}</span>
							<span class="metric-lbl">{t('cases.item4.metric2.label')}</span>
						</div>
						<div class="case-metric">
							<span class="metric-val font-cascadia-bold">{t('cases.item4.metric3.val')}</span>
							<span class="metric-lbl">{t('cases.item4.metric3.label')}</span>
						</div>
					</div>

					<div class="case-tech-stack">
						<span class="tech-chip">React</span>
						<span class="tech-chip">Node.js</span>
						<span class="tech-chip">CRDTs</span>
						<span class="tech-chip">Redis</span>
					</div>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="section about-section">
			<div class="about-grid">
				<div class="about-text">
					<h2>{t('about.title1')} <span class="highlight font-cascadia lowercase">{t('about.title2')}</span></h2>
					<p>{t('about.desc')}</p>
					<div class="stats-row">
						<div class="stat">
							<span class="stat-number font-cascadia-bold">50+</span>
							<span class="stat-label">{t('about.stats.projects')}</span>
						</div>
						<div class="stat">
							<span class="stat-number font-cascadia-bold">99%</span>
							<span class="stat-label">{t('about.stats.uptime')}</span>
						</div>
						<div class="stat">
							<span class="stat-number font-cascadia-bold">24/7</span>
							<span class="stat-label">{t('about.stats.support')}</span>
						</div>
					</div>
				</div>
				<div class="about-visual">
					<div class="glass-card">
						<div class="glass-icon">⚡</div>
						<h4 class="font-cascadia lowercase">{t('about.card1.title')}</h4>
						<p>{t('about.card1.desc')}</p>
					</div>
					<div class="glass-card">
						<div class="glass-icon">🛡️</div>
						<h4 class="font-cascadia lowercase">{t('about.card2.title')}</h4>
						<p>{t('about.card2.desc')}</p>
					</div>
					<div class="glass-card">
						<div class="glass-icon">📈</div>
						<h4 class="font-cascadia lowercase">{t('about.card3.title')}</h4>
						<p>{t('about.card3.desc')}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Get a Quote Section -->
		<section id="quote" class="section quote-section relative py-24">
