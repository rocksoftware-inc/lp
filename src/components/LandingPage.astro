        font-size: 0.6rem;
        font-weight: 800;
        color: rgba(244, 63, 94, 0.3);
        font-family: monospace;
    }

    /* Decision Gateway (BPMN diamond) */
    .flow-gateway {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .gateway-diamond {
        width: 44px;
        height: 44px;
        border: 2px solid #fbbf24;
        background: rgba(251, 191, 36, 0.05);
        transform: rotate(45deg);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

    .gateway-diamond svg {
        transform: rotate(-45deg);
        color: #fbbf24;
    }

    .gateway-diamond:hover {
        background: rgba(251, 191, 36, 0.12);
        box-shadow: 0 0 20px rgba(251, 191, 36, 0.15);
    }

    /* Mobile flowchart */
    @media (max-width: 768px) {
        .flowchart {
            flex-direction: column;
            padding: 2rem 1.5rem;
            gap: 0;
        }

        .flow-connector {
            width: 2px;
            height: 30px;
            flex-direction: column;
        }

        .connector-line {
            width: 2px;
            height: 100%;
            background: linear-gradient(180deg, rgba(244, 63, 94, 0.15), rgba(244, 63, 94, 0.4), rgba(244, 63, 94, 0.15));
        }

        .connector-chevron {
            transform: rotate(90deg);
        }

        @keyframes chevronPulse {
            0%, 100% { opacity: 0.4; transform: rotate(90deg) translateX(0); }
            50% { opacity: 0.9; transform: rotate(90deg) translateX(2px); }
        }

        .flow-node-task {
            min-width: unset;
            max-width: 100%;
            width: 100%;
        }
    }

    /* === MARQUEE === */
    .marquee-container {
        width: 100vw;
        position: relative;
        margin-left: calc(-50vw + 50%);
        overflow: hidden;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 0;
        background: rgba(24, 24, 27, 0.5);
        backdrop-filter: blur(10px);
        margin-top: 0;
    }

    .marquee-scroll {
        display: inline-flex;
        gap: 0;
        white-space: nowrap;
        animation: marquee-scroll 12s linear infinite;
        align-items: center;
    }

    .marquee-scroll span {
        font-weight: 800;
        font-size: 1rem;
        color: var(--text);
        letter-spacing: 2px;
        opacity: 0.5;
        flex-shrink: 0;
    }

    .marquee-scroll .dot {
        padding: 0 1rem;
    }

	@keyframes marquee-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    /* === SECTIONS === */
    .section {
        padding: 8rem 0;
        min-height: 60vh;
    }

    .section h2 {
        font-size: 3rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
    }

    /* === ABOUT === */
    .about-section {
        position: relative;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    .about-text {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .about-text.in-view {
        opacity: 1;
        transform: translateY(0);
    }

    .stats-row {
        display: flex;
        gap: 3rem;
        margin-top: 1rem;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .stat:nth-child(1) { transition-delay: 0.1s; }
    .stat:nth-child(2) { transition-delay: 0.2s; }
    .stat:nth-child(3) { transition-delay: 0.3s; }

    .stat.in-view {
        opacity: 1;
        transform: translateY(0);
    }

    .stat-number {
        font-size: 2.5rem;
        color: var(--primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.8rem;
        color: #71717a;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
    }

    .about-visual {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        padding: 1.5rem;
        backdrop-filter: blur(20px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 1.25rem;
        opacity: 0;
        transform: translateX(30px);
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .glass-card:nth-child(1) { transition-delay: 0.1s; }
    .glass-card:nth-child(2) { transition-delay: 0.2s; }
    .glass-card:nth-child(3) { transition-delay: 0.3s; }

    .glass-card.in-view {
        opacity: 1;
        transform: translateX(0);
    }

    .glass-card:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(244, 63, 94, 0.2);
        transform: translateX(8px);
    }

    .glass-icon {
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .glass-card h4 {
        font-size: 1rem;
        font-weight: 700;
        color: #e4e4e7;
        margin-bottom: 0.25rem;
    }

    .glass-card p {
        font-size: 0.8rem;
        color: #71717a;
        margin: 0;
        line-height: 1.4;
    }

    /* === ANIMATIONS === */
    @keyframes rotate {
        100% { transform: rotate(360deg); }
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
    }

    @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-slide-up {
        opacity: 0;
        animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-slide-down {
        opacity: 0;
        animation: slideDown 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* === FOOTER === */
    .site-footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
        padding-top: 4rem;
        margin-top: 4rem;
    }

    .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        display: grid;
        grid-template-columns: 1.5fr 1fr 1.5fr 1fr;
        gap: 2.5rem;
        margin-bottom: 3rem;
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .footer-tagline {
        font-size: 0.9rem !important;
        color: #71717a !important;
        line-height: 1.5 !important;
        margin: 0 !important;
    }

    .footer-section h3 {
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
        color: var(--primary);
        letter-spacing: 1px;
    }

    .footer-section ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .footer-section ul li a, .social-links a {
        color: #71717a;
        transition: all 0.3s;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .footer-section ul li a:hover, .social-links a:hover {
        color: var(--primary);
    }

    .footer-section p {
        font-size: 0.875rem;
        color: #71717a;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .social-links {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0;
        transition: all 0.3s;
    }

    .social-link:hover {
        transform: translateX(4px);
    }

    .footer-bottom {
        border-top: 1px solid var(--border);
        padding: 1.5rem 2rem;
        text-align: center;
        background: var(--bg);
    }

    .footer-bottom p {
        margin: 0;
        font-size: 0.75rem;
        color: #3f3f46;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    /* === CASES SECTION === */
    .cases-section {
        position: relative;
    }

    .cases-ambient {
        position: absolute;
        top: 20%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(244, 63, 94, 0.08) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .cases-filters {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 2.5rem 0 3.5rem;
        position: relative;
        z-index: 2;
    }

    .case-filter-btn {
        background: rgba(24, 24, 27, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #a1a1aa;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .case-filter-btn:hover {
        border-color: rgba(244, 63, 94, 0.5);
        color: #fff;
        transform: translateY(-2px);
    }

    .case-filter-btn.active {
        background: rgba(244, 63, 94, 0.15);
        border-color: var(--primary);
        color: #fff;
        box-shadow: 0 0 20px rgba(244, 63, 94, 0.25);
    }

    .cases-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        position: relative;
        z-index: 2;
    }

    .case-card {
        background: rgba(18, 18, 22, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(16px);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        opacity: 0;
        transform: translateY(20px);
    }

    .case-card.in-view {
        opacity: 1;
        transform: translateY(0);
    }

    .case-card:hover {
        border-color: rgba(244, 63, 94, 0.4);
        transform: translateY(-5px);
        box-shadow: 0 20px 40px -15px rgba(244, 63, 94, 0.18);
    }

    .case-card-glow {
        position: absolute;
        top: 0;
        right: 0;
        width: 160px;
        height: 160px;
        background: radial-gradient(circle, rgba(244, 63, 94, 0.15) 0%, transparent 70%);
        pointer-events: none;
        border-radius: 50%;
        transition: all 0.35s ease;
    }

    .case-card:hover .case-card-glow {
        transform: scale(1.4);
        background: radial-gradient(circle, rgba(244, 63, 94, 0.25) 0%, transparent 70%);
    }

    .case-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.25rem;
    }

    .case-tag {
        display: inline-block;
        font-size: 0.7rem;
        color: var(--primary);
        background: rgba(244, 63, 94, 0.1);
        border: 1px solid rgba(244, 63, 94, 0.2);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        margin-bottom: 0.5rem;
    }

    .case-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.5px;
    }

    .case-arrow {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #71717a;
        transition: all 0.3s;
    }

    .case-card:hover .case-arrow {
        color: var(--primary);
        border-color: var(--primary);
        transform: translate(2px, -2px);
    }

    .case-desc {
        color: #a1a1aa;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.75rem;
    }

    .case-metrics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        padding: 1.25rem;
        background: rgba(9, 9, 11, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .case-metric {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .metric-val {
        font-size: 1.25rem;
        color: var(--primary);
        line-height: 1.2;
    }

    .metric-lbl {
        font-size: 0.7rem;
        color: #71717a;
        text-transform: uppercase;
        margin-top: 0.25rem;
        letter-spacing: 0.5px;
    }

    .case-tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tech-chip {
        font-size: 0.75rem;
        font-family: 'Cascadia Code', monospace;
        color: #94a3b8;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        padding: 0.25rem 0.65rem;
    }

    /* === GET A QUOTE SECTION === */
    .quote-section {
        position: relative;
    }

    .quote-ambient {
        position: absolute;
        top: 40%;
        right: 10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .quote-container {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 3rem;
        align-items: start;
        position: relative;
        z-index: 2;
        margin-top: 3rem;
    }

    .quote-builder {
        background: rgba(18, 18, 22, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 2.5rem;
        backdrop-filter: blur(16px);
        display: flex;
        flex-direction: column;
        gap: 2.25rem;
    }

    .quote-step {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .quote-step-title {
        font-size: 0.95rem;
        color: #e4e4e7;
        letter-spacing: 0.5px;
    }

    .quote-options-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.85rem;
    }

    .quote-opt-btn {
        background: rgba(9, 9, 11, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #d4d4d8;
        cursor: pointer;
        transition: all 0.25s ease;
        text-align: left;
    }

    .quote-opt-btn:hover {
        border-color: rgba(244, 63, 94, 0.4);
        background: rgba(24, 24, 27, 0.8);
        transform: translateY(-2px);
    }

    .quote-opt-btn.active {
        background: rgba(244, 63, 94, 0.12);
        border-color: var(--primary);
        color: #fff;
        box-shadow: 0 0 20px rgba(244, 63, 94, 0.2);
    }

    .opt-icon {
        font-size: 1.25rem;
    }

    .opt-text {
        font-size: 0.85rem;
        font-weight: 500;
    }

    .quote-features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }

    .feature-checkbox {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.1rem;
        background: rgba(9, 9, 11, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.85rem;
        color: #a1a1aa;
        user-select: none;
    }

    .feature-checkbox input {
        display: none;
    }

    .feature-checkbox .check-box {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        color: transparent;
        transition: all 0.2s;
    }

    .feature-checkbox.active {
        border-color: rgba(244, 63, 94, 0.4);
        background: rgba(244, 63, 94, 0.08);
        color: #fff;
    }

    .feature-checkbox.active .check-box {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .quote-briefing-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .quote-pills-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .quote-pill-btn {
        background: rgba(9, 9, 11, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 9999px;
        padding: 0.45rem 0.95rem;
        font-size: 0.8rem;
        color: #a1a1aa;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
    }

    .quote-pill-btn:hover {
        border-color: rgba(244, 63, 94, 0.4);
        color: #fff;
        transform: translateY(-1px);
    }

    .quote-pill-btn.active {
        background: rgba(244, 63, 94, 0.15);
        border-color: var(--primary);
        color: #fff;
        box-shadow: 0 0 15px rgba(244, 63, 94, 0.2);
    }

    .quote-summary-card {
        background: linear-gradient(145deg, rgba(24, 24, 27, 0.85), rgba(15, 15, 18, 0.95));
        border: 1px solid rgba(244, 63, 94, 0.3);
        box-shadow: 0 25px 50px -12px rgba(244, 63, 94, 0.15);
        border-radius: 18px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: sticky;
        top: 6rem;
    }

    .summary-badge {
        font-size: 0.7rem;
        color: #34d399;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .summary-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
        margin-top: 0.25rem;
    }

    .summary-detail-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .summary-label {
        font-size: 0.8rem;
        color: #71717a;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .summary-val {
        font-size: 1.25rem;
        color: var(--primary);
    }

    .summary-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .summary-cta-box {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .summary-note {
        font-size: 0.75rem;
        color: #71717a;
        text-align: center;
    }

    /* === CONTACT SECTION === */
    .contact-section {
        position: relative;
    }

    .contact-ambient {
        position: absolute;
        bottom: 20%;
        left: 20%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(244, 63, 94, 0.08) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 3.5rem;
        position: relative;
        z-index: 2;
        margin-top: 3rem;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .contact-card {
        background: rgba(18, 18, 22, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        backdrop-filter: blur(14px);
        transition: all 0.3s ease;
    }

    .contact-card:hover {
        border-color: rgba(244, 63, 94, 0.3);
        transform: translateX(4px);
    }

    .contact-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        flex-shrink: 0;
    }

    .contact-card-content {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .contact-label {
        font-size: 0.75rem;
        color: #71717a;
    }

    .contact-val {
        font-size: 0.95rem;
        color: #ffffff;
        font-weight: 500;
        transition: color 0.2s;
    }

    a.contact-val:hover {
        color: var(--primary);
    }

    .contact-form-container {
        background: rgba(18, 18, 22, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 2.75rem;
        backdrop-filter: blur(16px);
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #a1a1aa;
        letter-spacing: 0.3px;
    }

    .form-input {
        background: rgba(9, 9, 11, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 0.85rem 1rem;
        color: #fff;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
