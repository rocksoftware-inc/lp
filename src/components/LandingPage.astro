    <script>
        // Smooth slideshow cycling through the 4 rock concert images
        const slides = document.querySelectorAll('.hero-bg-slide');
        if (slides.length > 0) {
            let currentSlide = 0;
            setInterval(() => {
                slides[currentSlide].classList.remove('active');
                currentSlide = (currentSlide + 1) % slides.length;
                slides[currentSlide].classList.add('active');
            }, 6000);
        }

        // Smooth scroll for explore button to cases
        document.getElementById('explore-btn')?.addEventListener('click', () => {
            document.getElementById('cases')?.scrollIntoView({ behavior: 'smooth' });
        });

        // Intersection Observer for scroll animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.glass-card, .stat, .about-text, .case-card, .contact-card, .quote-builder, .quote-summary-card').forEach(el => {
            observer.observe(el);
        });

        // === CASES FILTER LOGIC ===
        const filterBtns = document.querySelectorAll('.case-filter-btn');
        const caseCards = document.querySelectorAll('.case-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.getAttribute('data-filter');
                caseCards.forEach(card => {
                    const category = card.getAttribute('data-category');
                    if (filter === 'all' || category === filter) {
                        (card as HTMLElement).style.display = 'flex';
                        setTimeout(() => {
                            (card as HTMLElement).style.opacity = '1';
                            (card as HTMLElement).style.transform = 'translateY(0)';
                        }, 50);
                    } else {
                        (card as HTMLElement).style.opacity = '0';
                        (card as HTMLElement).style.transform = 'translateY(15px)';
                        setTimeout(() => {
                            (card as HTMLElement).style.display = 'none';
                        }, 250);
                    }
                });
            });
        });

        // === QUOTE BUILDER LOGIC ===
        const typeBtns = document.querySelectorAll('.quote-types .quote-opt-btn');
        const timelineBtns = document.querySelectorAll('.quote-timelines .quote-opt-btn');
        const featureLabels = document.querySelectorAll('.feature-checkbox');
        const timelineVal = document.getElementById('quote-timeline-val');
        const stackChips = document.getElementById('quote-stack-chips');
        const quoteApplyBtn = document.getElementById('quote-apply-btn');

        let currentType = 'web';
        let currentTypeLabel = 'Web App & SaaS';
        let currentTimeline = 'mvp';
        let currentTimelineText = '2 - 4 semanas';
        let currentGoal = 'Lançar Novo Produto';
        let currentBudget = 'R$ 20k - R$ 50k';

        const stackMap: Record<string, string[]> = {
            web: ['Next.js / React', 'Node.js / Go', 'PostgreSQL', 'Cloudflare Edge'],
            mobile: ['React Native / Flutter', 'GraphQL / REST', 'Supabase / AWS', 'Tailwind'],
            backend: ['Go / Rust', 'gRPC / Kafka', 'ClickHouse', 'Kubernetes'],
            ai: ['Python / FastAPI', 'LangChain / LLM', 'Vector DB (Pgvector)', 'Docker']
        };

        const timelineMap: Record<string, string> = {
            mvp: '2 - 4 semanas',
            scale: '1 - 3 meses',
            enterprise: 'Sob medida / Contínuo'
        };

        const briefingTextInput = document.getElementById('quote-briefing-text') as HTMLTextAreaElement | null;
        const briefingStatus = document.getElementById('quote-briefing-status');
        const quoteWhatsAppBtn = document.getElementById('quote-whatsapp-btn') as HTMLAnchorElement | null;

        function getFullBriefingMessage() {
            const activeFeatures = Array.from(document.querySelectorAll('.feature-checkbox.active span:last-child'))
                .map(el => el.textContent?.trim())
                .filter(Boolean);

            const details = briefingTextInput?.value.trim();
            let msg = `Olá! Gostaria de receber uma proposta para:\n• Categoria: ${currentTypeLabel}\n• Escopo/Prazo: ${currentTimelineText}\n• Objetivo: ${currentGoal}\n• Faixa de Investimento: ${currentBudget}\n• Recursos: ${activeFeatures.join(', ')}`;
            if (details) {
                msg += `\n\nBriefing do Projeto:\n"${details}"`;
            }
            return msg;
        }

        function updateQuoteSummary() {
            if (timelineVal) {
                timelineVal.textContent = timelineMap[currentTimeline] || '2 - 4 semanas';
            }
            if (stackChips && stackMap[currentType]) {
                stackChips.innerHTML = stackMap[currentType]
                    .map(tech => `<span class="tech-chip">${tech}</span>`)
                    .join('');
            }

            const details = briefingTextInput?.value.trim();
            if (briefingStatus) {
                if (details || currentGoal) {
                    briefingStatus.textContent = '✓ Briefing estruturado';
                    briefingStatus.style.color = '#34d399';
                } else {
                    briefingStatus.textContent = 'Aguardando detalhes...';
                    briefingStatus.style.color = '#a1a1aa';
                }
            }

            if (quoteWhatsAppBtn) {
                const fullMsg = getFullBriefingMessage();
                quoteWhatsAppBtn.href = `https://wa.me/5511947376930?text=${encodeURIComponent(fullMsg)}`;
            }
        }

        typeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                typeBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentType = btn.getAttribute('data-type') || 'web';
                currentTypeLabel = btn.getAttribute('data-label') || currentType;
                updateQuoteSummary();
            });
        });

        timelineBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                timelineBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentTimeline = btn.getAttribute('data-timeline') || 'mvp';
                currentTimelineText = btn.getAttribute('data-label') || currentTimeline;
                updateQuoteSummary();
            });
        });

        // Goal pills
        const goalBtns = document.querySelectorAll('.quote-goals .quote-pill-btn');
        goalBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                goalBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentGoal = btn.getAttribute('data-goal') || btn.textContent || '';
                updateQuoteSummary();
            });
        });

        // Budget pills
        const budgetBtns = document.querySelectorAll('.quote-budgets .quote-pill-btn');
        budgetBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                budgetBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentBudget = btn.getAttribute('data-budget') || btn.textContent || '';
                updateQuoteSummary();
            });
        });

        // Briefing textarea input
        briefingTextInput?.addEventListener('input', () => {
            updateQuoteSummary();
        });

        featureLabels.forEach(label => {
            const input = label.querySelector('input');
            input?.addEventListener('change', () => {
                if (input.checked) {
                    label.classList.add('active');
                } else {
                    label.classList.remove('active');
                }
                updateQuoteSummary();
            });
        });

        quoteApplyBtn?.addEventListener('click', () => {
            const contactSection = document.getElementById('contact');
            contactSection?.scrollIntoView({ behavior: 'smooth' });

            const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement | null;
            if (serviceSelect) {
                if (currentType === 'ai') serviceSelect.value = 'ai';
                else if (currentType === 'backend') serviceSelect.value = 'cloud';
                else if (currentTimeline === 'mvp') serviceSelect.value = 'mvp';
                else serviceSelect.value = 'refactor';
            }

            const messageField = document.getElementById('contact-message') as HTMLTextAreaElement | null;
            if (messageField) {
                messageField.value = getFullBriefingMessage();
            }

            const nameField = document.getElementById('contact-name');
            nameField?.focus();
        });

        // Initialize quote summary
        updateQuoteSummary();

        // === CONTACT FORM LOGIC ===
        const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('submit-contact-btn');
        const btnText = document.getElementById('btn-text');
        const successMsg = document.getElementById('contact-success-msg');

        contactForm?.addEventListener('submit', (e) => {
            e.preventDefault();
            if (submitBtn && btnText) {
                submitBtn.setAttribute('disabled', 'true');
                const originalText = btnText.textContent;
                btnText.textContent = '...';

                setTimeout(() => {
                    btnText.textContent = originalText;
                    submitBtn.removeAttribute('disabled');
                    if (successMsg) {
                        successMsg.classList.remove('hidden');
                        setTimeout(() => {
                            successMsg.classList.add('hidden');
                        }, 6000);
                    }
                    contactForm.reset();
                }, 800);
            }
        });
    </script>
</Layout>

